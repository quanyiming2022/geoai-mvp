# Local development only. Generate secrets with scripts/init_env.py.
COMPOSE_FILE=infra/supabase/upstream/docker-compose.yml:infra/docker-compose.geoai.yml
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
API_EXTERNAL_URL=http://127.0.0.1:8000/auth/v1
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=geoai
POOLER_DB_POOL_SIZE=5
STUDIO_DEFAULT_ORGANIZATION=GeoAI
STUDIO_DEFAULT_PROJECT=Local P0
OPENAI_API_KEY=
SITE_URL=http://127.0.0.1:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=true
GLOBAL_S3_BUCKET=stub
REGION=stub
MINIO_ROOT_USER=supa-storage
MINIO_ROOT_PASSWORD=
STORAGE_TENANT_ID=stub
FUNCTIONS_VERIFY_JWT=true
PGRST_DB_SCHEMAS=public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER
API_GW_HTTP_PORT=127.0.0.1:8000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
IMGPROXY_AUTO_WEBP=true
PROXY_DOMAIN=your-domain.example.com
CERTBOT_EMAIL=admin@example.com
GEOAI_DB_PORT=54322
GEOAI_REDIS_PORT=6379
GEOAI_API_PORT=8080
GEOAI_WEB_PORT=3000
STORAGE_BUCKET=geoai
STORAGE_FILE_SIZE_LIMIT=10737418240
COMPOSE_PROJECT_NAME=geoai-mvp

# Set true behind HTTPS in private deployments; localhost HTTP uses false.
GEOAI_COOKIE_SECURE=false

# Bounded streaming upload, default 512 MiB.
MAX_UPLOAD_BYTES=536870912
MAX_RASTER_PIXELS=1000000000
RASTER_TIMEOUT_SECONDS=300

# P9C optional language assistant; local native Ollama by default
LLM_LOCAL_URL=http://host.docker.internal:11434
LLM_ALLOWED_ORIGINS=
LLM_LAN_API_KEY=
LLM_CLOUD_API_KEY=
